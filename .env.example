# API Key (必填)
# 获取地址: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxx

# 模型 ID (必填)
MODEL_ID=claude-sonnet-4-5

# Base URL (可选, 用于 Anthropic 兼容提供商)
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# =============================================================================
#  Anthropic 兼容提供商示例
#
#  提供商           MODEL_ID                    Base URL
#  ---------------  --------------------------  -----------------------------
#  Anthropic        claude-sonnet-4-5           (默认)
#  DeepSeek         deepseek-chat               https://api.deepseek.com/anthropic
#  GLM (智谱)       glm-4.6                     https://open.bigmodel.cn/api/anthropic
#  Kimi (月之暗面)  kimi-k2-turbo-preview       https://api.moonshot.cn/anthropic
#  MiniMax          MiniMax-M2                  https://api.minimaxi.com/anthropic
#
#  请以各提供商最新文档为准。
# =============================================================================
